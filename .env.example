# ─── Supabase (Stage 11: real backend; app runs in mock mode without these) ───
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# NEVER expose service-role keys to the browser (no NEXT_PUBLIC_ prefix).

# Supabase project URL (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (public, safe for the browser — RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — bypasses RLS).
# Only used in server-side admin provisioning scripts, never in app code.
# Leave empty unless you know why you need it.
SUPABASE_SERVICE_ROLE_KEY=
